{
    "control": {
        "storage_dir": "./Si_pseudo"
    },

    "sysparams": {
        "element": "Si",
        "file_upf": "../tests/data/Si/Si.oncvpsp.upf",
        "lmax": 2,
        "nmax": 1
    },

    "solver": {
        "h_min": 0.5,
        "h_max": 4.0,
        "Rmax": 30.0,
        "ng": 8
    },

    "dft": {
        "driver": "internal",
        "xc_functional": "PBE",
        "mixing_scheme": "anderson",
        "alpha_mix": 0.5,
        "max_iter": 100,
        "conv_tol": 1.0e-8
    },

    "confinement": {
        "type": "SoftStep",
        "rc": 20.0,
        "ri_factor": 0.5,
        "Vbarrier": 1.0,
        "polarization_mode": "SoftCoul",
        "softcoul_delta": 0.1
    },

    "output": {
        "output_wfc_qe": true,
        "qe_num_points": 2001,
        "output_wfc_bessel": true,
        "bessel_quad_npoints": 81,
        "bessel_quad_method": "Simpson",
        "bessel_qmax": 20.0,
        "bessel_nq": 200
    }
}
